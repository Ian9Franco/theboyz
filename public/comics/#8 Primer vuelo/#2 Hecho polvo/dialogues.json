            { "text": "No. El conector entró, pero el seguro secundario no cerró.", "size": "small", "posX": 50, "posY": 55, "tailX": 0, "tailY": 60, "tailWidth": 6, "tailCurvature": -22, "width": 370, "fontSize": 8, "borderRadius": 14 },
            { "text": "Con la vibración retrocedió uno de los pines de señal. Hace contacto en reposo y se abre cuando el motor de arranque mueve el conjunto.", "size": "small", "posX": 30, "posY": 70, "tailX": -10, "tailY": 65, "tailWidth": 6, "tailCurvature": -22, "width": 240, "fontSize": 8, "borderRadius": 18 }
          ]
        },
        {
          "focusY": 0.9,
          "dialogue": [
            { "text": "parece bueno", "size": "small", "posX": 100, "posY": 80, "tailX": 90, "tailY": 85, "tailWidth": 6, "tailCurvature": -22, "width": 120, "fontSize": 8, "borderRadius": 18 },
            { "text": "Con la vibración retrocedió uno de los pines de señal. Hace contacto en reposo y se abre cuando el motor de arranque mueve el conjunto.", "size": "small", "posX": 45, "posY": 70, "tailX": 55, "tailY": 80, "tailWidth": 6, "tailCurvature": -22, "width": 285, "fontSize": 8, "borderRadius": 18 },
            { "text": "¿La carrera Kurogane?", "size": "small", "posX": 5, "posY": 80, "tailX": 20, "tailY": 85, "tailWidth": 6, "tailCurvature": -22, "width": 120, "fontSize": 8, "borderRadius": 18 },
            { "text": "Ahí no conviene preguntar demasiado.", "size": "small", "posX": 85, "posY": 70, "tailX": 70, "tailY": 85, "tailWidth": 6, "tailCurvature": -22, "width": 120, "fontSize": 8, "borderRadius": 18 },
            { "text": "¿Esto me deja entrar?", "size": "small", "posX": 0, "posY": 85, "tailX": 20, "tailY": 85, "tailWidth": 6, "tailCurvature": -22, "width": 120, "fontSize": 8, "borderRadius": 18 },
            { "text": "A la conferencia. Nada más.\nY si alguien pregunta, venís de parte del taller.", "size": "small", "posX": 110, "posY": 90, "tailX": 85, "tailY": 85, "tailWidth": 6, "tailCurvature": -22, "width": 120, "fontSize": 8, "borderRadius": 18 }
