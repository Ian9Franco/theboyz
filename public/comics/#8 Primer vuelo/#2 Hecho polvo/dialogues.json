            { "text": "TÉCNICO 1:\nLa presión cae cada vez que entra el segundo mapa.", "size": "small", "posX": 55, "posY": 0, "tailX": 40, "tailY": 10, "tailWidth": 6, "tailCurvature": -22, "width": 120, "fontSize": 8, "borderRadius": 18 },
