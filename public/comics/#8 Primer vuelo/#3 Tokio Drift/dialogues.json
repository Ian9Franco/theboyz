            { "text": "Otro día entero en el taller..", "speaker": "Ian", "size": "small", "posX": 50, "posY": 5, "tailX": 35, "tailY": 10, "tailWidth": 6, "tailCurvature": -22, "width": 140, "fontSize": 8, "borderRadius": 18, "style": "thought" }
          ],
          "zoomRects": [
