          ]
        },
        {
          "focusY": 0.5,
          "dialogue": [
            { "text": "Luces fuera. Mañana va a ser un día agitado.", "speaker": "Ian", "size": "small", "posX": 50, "posY": 45, "tailX": 35, "tailY": 50, "tailWidth": 6, "tailCurvature": -22, "width": 140, "fontSize": 8, "borderRadius": 18, "style": "thought" }
          ],
          "sounds": [
