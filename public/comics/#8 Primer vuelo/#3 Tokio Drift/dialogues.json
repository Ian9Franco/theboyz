    "2": {
      "panels": [
        {
          "focusY": 0.25,
          "dialogue": [
            { "text": "la puta madre", "speaker": "Ian", "size": "small", "posX": 35, "posY": 5, "tailX": 30, "tailY": 15, "tailWidth": 6, "tailCurvature": -22, "width": 140, "fontSize": 8, "borderRadius": 18 }
          ],
          "sounds": [
            {
              "sound": "/sounds/sfx/alarma.mp3",
              "soundStartTime": 0,
              "soundConfig": {
                "volume": 0.35,
                "playbackRate": 1
              }
            }
          ]
        },
        {
          "focusY": 0.65,
          "dialogue": [
            { "text": "Aaah... ", "speaker": "Ian", "size": "small", "posX": 50, "posY": 45, "tailX": 35, "tailY": 55, "tailWidth": 6, "tailCurvature": -22, "width": 140, "fontSize": 8, "borderRadius": 18 },
            { "text": "Nada que un buen café cargado no pueda solucionar.", "speaker": "Ian", "size": "small", "posX": 90, "posY": 40, "tailX": 75, "tailY": 55, "tailWidth": 6, "tailCurvature": -22, "width": 140, "fontSize": 8, "borderRadius": 18 }
          ]
        }
      ]
    },
    "3": {
      "panels": [
        {
          "focusY": 0.2,
          "dialogue": [
            { "text": "esa torre parece una eiffel berreta ", "speaker": "Ian", "size": "small", "posX": 80, "posY": 5, "tailX": 75, "tailY": 20, "tailWidth": 6, "tailCurvature": -22, "width": 170, "fontSize": 8, "borderRadius": 13, "style": "thought" }
          ]
        },
        {
          "focusY": 0.7,
          "dialogue": [
            { "text": "Bolso con herramientas, la compu... todo en su lugar.", "speaker": "Ian", "size": "small", "posX": 50, "posY": 50, "tailX": 35, "tailY": 60, "tailWidth": 6, "tailCurvature": -22, "width": 140, "fontSize": 8, "borderRadius": 18, "style": "thought" }
          ]
        }
      ]
    },
    "4": {
      "panels": [
        {
          "focusY": 0.2,
          "dialogue": [
            { "text": ".. ahí están todos.", "speaker": "Ian", "size": "small", "posX": 45, "posY": 10, "tailX": 35, "tailY": 20, "tailWidth": 6, "tailCurvature": -22, "width": 130, "fontSize": 8, "borderRadius": 18 }
          ]
        },
        {
          "focusY": 0.5,
          "dialogue": [
            { "text": "¡Buenas! ¿Cómo arrancó la mañana por acá?", "speaker": "Ian", "size": "small", "posX": 35, "posY": 35, "tailX": 25, "tailY": 45, "tailWidth": 6, "tailCurvature": -22, "width": 130, "fontSize": 8, "borderRadius": 18 },
            { "text": "Llegas justo a tiempo", "speaker": "Brooke", "size": "small", "posX": 55, "posY": 30, "tailX": 55, "tailY": 40, "tailWidth": 6, "tailCurvature": -22, "width": 140, "fontSize": 8, "borderRadius": 18 },
            { "text": "Revisando la telemetría. Ren dice que escucha un ruido raro en el motor.", "speaker": "Daichi", "size": "small", "posX": 75, "posY": 25, "tailX": 75, "tailY": 40, "tailWidth": 6, "tailCurvature": -22, "width": 140, "fontSize": 8, "borderRadius": 18 },
            { "text": "El único raro es el viejo verde de Daichi ", "speaker": "Ren", "size": "small", "posX": 95, "posY": 25, "tailX": 95, "tailY": 40, "tailWidth": 6, "tailCurvature": -22, "width": 140, "fontSize": 8, "borderRadius": 18 }
          ]
        },
        {
          "focusY": 0.8,
          "dialogue": [
            { "text": "Menos chistes y miren esto. Abrí los registros de la última prueba.", "speaker": "Ian", "size": "small", "posX": 35, "posY": 70, "tailX": 25, "tailY": 80, "tailWidth": 6, "tailCurvature": -22, "width": 150, "fontSize": 8, "borderRadius": 18 }
          ]
        }
      ]
    },
    "5": {
      "panels": [
        {
          "focusY": 0.2,
          "dialogue": [
            { "text": "La presión del turbo está perfecta. El Skyline responde de maravilla.", "speaker": "Daichi", "size": "small", "posX": 40, "posY": 15, "tailX": 40, "tailY": 25, "tailWidth": 6, "tailCurvature": -22, "width": 150, "fontSize": 8, "borderRadius": 18 },
            { "text": "Perfecto. Solo nos falta encontrar competencia que esté a nuestra altura.", "speaker": "Ren", "size": "small", "posX": 80, "posY": 15, "tailX": 80, "tailY": 25, "tailWidth": 6, "tailCurvature": -22, "width": 150, "fontSize": 8, "borderRadius": 18 }
          ]
        },
        {
          "focusY": 0.4,
          "dialogue": [
            { "text": "ALERTA: Emisor de señales activo. Transmisión encriptada entrante.", "speaker": "BYTE", "size": "small", "posX": 50, "posY": 38, "tailX": 50, "tailY": 48, "tailWidth": 6, "tailCurvature": -22, "width": 150, "fontSize": 8, "borderRadius": 18 }
          ]
        },
        {
          "focusY": 0.65,
          "dialogue": [
            { "text": "¿Una señal codificada al taller? A ver qué es lo que nos enviaron...", "speaker": "Brooke", "size": "small", "posX": 75, "posY": 60, "tailX": 75, "tailY": 70, "tailWidth": 6, "tailCurvature": -22, "width": 150, "fontSize": 8, "borderRadius": 18 }
          ]
        },
        {
          "focusY": 0.88,
          "dialogue": [
            { "text": "Es una ruta holográfica... con el código de invitación a la Gran Carrera del Distrito.", "speaker": "Ian", "size": "small", "posX": 20, "posY": 85, "tailX": 20, "tailY": 95, "tailWidth": 6, "tailCurvature": -22, "width": 150, "fontSize": 8, "borderRadius": 18 },
            { "text": "Solo invitan a los pilotos más rápidos del circuito clandestino...", "speaker": "Brooke", "size": "small", "posX": 85, "posY": 85, "tailX": 85, "tailY": 95, "tailWidth": 6, "tailCurvature": -22, "width": 140, "fontSize": 8, "borderRadius": 18 }
          ]
        }
      ]
    },
    "6": {
      "panels": [
        {
          "focusY": 0.25,
          "dialogue": [
            { "text": "Exigen competir en dos categorías distintas... ahí está el desafío.", "speaker": "Daichi", "size": "small", "posX": 50, "posY": 18, "tailX": 50, "tailY": 28, "tailWidth": 6, "tailCurvature": -22, "width": 150, "fontSize": 8, "borderRadius": 18 },
            { "text": "Con el Skyline cubrimos la principal, pero necesitamos otro auto para la segunda.", "speaker": "Ren", "size": "small", "posX": 80, "posY": 18, "tailX": 80, "tailY": 28, "tailWidth": 6, "tailCurvature": -22, "width": 150, "fontSize": 8, "borderRadius": 18 }
          ]
        },
        {
          "focusY": 0.6,
          "dialogue": [
            { "text": "No tenemos presupuesto para un auto de carrera nuevo...", "speaker": "Ian", "size": "small", "posX": 30, "posY": 55, "tailX": 30, "tailY": 65, "tailWidth": 6, "tailCurvature": -22, "width": 140, "fontSize": 8, "borderRadius": 18 },
            { "text": "Tiene que ser algo con potencial que podamos reconstruir acá.", "speaker": "Brooke", "size": "small", "posX": 75, "posY": 55, "tailX": 75, "tailY": 65, "tailWidth": 6, "tailCurvature": -22, "width": 140, "fontSize": 8, "borderRadius": 18 }
          ]
        },
        {
          "focusY": 0.85,
          "dialogue": [
            { "text": "Déjenme revisar mis contactos... Conozco un clásico en un desarmadero del oeste.", "speaker": "Ren", "size": "small", "posX": 40, "posY": 85, "tailX": 40, "tailY": 95, "tailWidth": 6, "tailCurvature": -22, "width": 150, "fontSize": 8, "borderRadius": 18 }
          ]
        }
      ]
    },
    "7": {
      "panels": [
        {
          "focusY": 0.25,
          "dialogue": [
            { "text": "¡Miren esto! Es un viejo Mitsubishi Eclipse GT. Lo tienen guardado bajo una lona.", "speaker": "Ren", "size": "small", "posX": 50, "posY": 18, "tailX": 50, "tailY": 28, "tailWidth": 6, "tailCurvature": -22, "width": 160, "fontSize": 8, "borderRadius": 18 }
          ]
        },
        {
          "focusY": 0.5,
          "dialogue": [
            { "text": "Está algo descuidado... pero las líneas del chasís están impecables.", "speaker": "Brooke", "size": "small", "posX": 40, "posY": 48, "tailX": 40, "tailY": 58, "tailWidth": 6, "tailCurvature": -22, "width": 150, "fontSize": 8, "borderRadius": 18 }
          ]
        },
        {
          "focusY": 0.75,
          "dialogue": [
            { "text": "El motor turbo de ese Eclipse GT es legendario. Con una buena puesta a punto va a volar.", "speaker": "Daichi", "size": "small", "posX": 30, "posY": 75, "tailX": 30, "tailY": 85, "tailWidth": 6, "tailCurvature": -22, "width": 160, "fontSize": 8, "borderRadius": 18 },
            { "text": "Si el block está sano, podemos adaptarle nuestro sistema de inyección.", "speaker": "Ian", "size": "small", "posX": 70, "posY": 75, "tailX": 70, "tailY": 85, "tailWidth": 6, "tailCurvature": -22, "width": 150, "fontSize": 8, "borderRadius": 18 }
          ]
        },
        {
          "focusY": 0.9,
          "dialogue": [
            { "text": "Voy a ir al desarmadero a buscarlo antes de que alguien más le ponga el ojo.", "speaker": "Ren", "size": "small", "posX": 40, "posY": 88, "tailX": 40, "tailY": 98, "tailWidth": 6, "tailCurvature": -22, "width": 160, "fontSize": 8, "borderRadius": 18 }
          ]
        }
      ]
    },
    "8": {
      "panels": [
        {
          "focusY": 0.2,
          "dialogue": [
            { "text": "Tengo la ubicación exacta. Voy a negociar el precio y me lo traigo.", "speaker": "Ren", "size": "small", "posX": 60, "posY": 5, "tailX": 55, "tailY": 15, "tailWidth": 6, "tailCurvature": -22, "width": 150, "fontSize": 8, "borderRadius": 18 }
          ]
        },
        {
          "focusY": 0.5,
          "dialogue": [
            { "text": "BYTE y yo iremos preparando el mapa de inyección en la laptop mientras lo remolcás.", "speaker": "Ian", "size": "small", "posX": 45, "posY": 40, "tailX": 60, "tailY": 45, "tailWidth": 6, "tailCurvature": -22, "width": 160, "fontSize": 8, "borderRadius": 18 },
            { "text": "Planos de reconstrucción del Eclipse GT cargados.", "speaker": "BYTE", "style": "electronic", "size": "small", "posX": 105, "posY": 45, "tailX": 90, "tailY": 55, "tailWidth": 6, "tailCurvature": -22, "width": 130, "fontSize": 8, "borderRadius": 18 }
          ]
        },
        {
          "focusY": 0.75,
          "dialogue": [
            { "text": "Confíen en mí. En un par de horas tenemos ese Mitsubishi Eclipse GT en el taller.", "speaker": "Ren", "size": "small", "posX": 10, "posY": 60, "tailX": 30, "tailY": 70, "tailWidth": 6, "tailCurvature": -22, "width": 160, "fontSize": 8, "borderRadius": 18 }
          ]
        },
        {
          "focusY": 0.9,
          "dialogue": [
            { "text": "Los veo en unas horas", "speaker": "Ian", "size": "small", "posX": 35, "posY": 80, "tailX": 30, "tailY": 85, "tailWidth": 6, "tailCurvature": -22, "width": 130, "fontSize": 8, "borderRadius": 18 },
            { "text": "¡No traigas más chatarra de la cuenta!", "speaker": "Brooke", "size": "small", "posX": 90, "posY": 75, "tailX": 80, "tailY": 85, "tailWidth": 6, "tailCurvature": -22, "width": 130, "fontSize": 8, "borderRadius": 18 }
          ]
        }
      ]
    },
    "9": {
      "panels": [
        {
          "focusY": 0.2,
          "dialogue": [
            { "text": "Acá está... el viejo Eclipse GT tal como dijo el contacto.", "speaker": "Ren", "size": "small", "posX": 45, "posY": 5, "tailX": 30, "tailY": 15, "tailWidth": 6, "tailCurvature": -22, "width": 150, "fontSize": 8, "borderRadius": 18 }
          ]
        },
        {
          "focusY": 0.4,
          "dialogue": [
            { "text": "Acá tenés el dinero pactado en efectivo. El título queda a mi nombre.", "speaker": "Ren", "size": "small", "posX": 30, "posY": 30, "tailX": 15, "tailY": 35, "tailWidth": 6, "tailCurvature": -22, "width": 150, "fontSize": 8, "borderRadius": 18 },
            { "text": "Todo tuyo, pibe. Llevátelo antes de que me arrepienta.", "speaker": "Dueño", "size": "small", "posX": 65, "posY": 30, "tailX": 60, "tailY": 45, "tailWidth": 6, "tailCurvature": -22, "width": 140, "fontSize": 8, "borderRadius": 18 }
          ]
        },
        {
          "focusY": 0.65,
          "dialogue": [
            { "text": "Un poco de polvo no le hace nada... este bicho va a renacer en nuestras manos.", "speaker": "Ren", "size": "small", "posX": 35, "posY": 50, "tailX": 25, "tailY": 60, "tailWidth": 6, "tailCurvature": -22, "width": 160, "fontSize": 8, "borderRadius": 18 }
          ]
        },
        {
          "focusY": 0.85,
          "dialogue": [
            { "text": "Listo el transporte. Nos vamos directo al taller.", "speaker": "Ren", "size": "small", "posX": 60, "posY": 80, "tailX": 70, "tailY": 90, "tailWidth": 6, "tailCurvature": -22, "width": 140, "fontSize": 8, "borderRadius": 18 }
          ]
        }
      ]
    },
    "10": {
      "panels": [
        {
          "focusY": 0.2,
          "dialogue": [
            { "text": "¡Mirá lo que trajiste, Ren! Parece recién salido de una película de culto.", "speaker": "Brooke", "size": "small", "posX": 50, "posY": 5, "tailX": 65, "tailY": 15, "tailWidth": 6, "tailCurvature": -22, "width": 160, "fontSize": 8, "borderRadius": 18 },
            { "text": "Les dije que no los iba a defraudar.", "speaker": "Ren", "size": "small", "posX": 25, "posY": 5, "tailX": 20, "tailY": 10, "tailWidth": 6, "tailCurvature": -22, "width": 130, "fontSize": 8, "borderRadius": 18 }
          ]
        },
        {
          "focusY": 0.45,
          "dialogue": [
            { "text": "El block motor está entero, pero hay que rehacer el cableado de inyección completo.", "speaker": "Ian", "size": "small", "posX": 50, "posY": 30, "tailX": 30, "tailY": 40, "tailWidth": 6, "tailCurvature": -22, "width": 160, "fontSize": 8, "borderRadius": 18 }
          ]
        },
        {
          "focusY": 0.7,
          "dialogue": [
            { "text": "Los espirales y discos necesitan refuerzo para soportar la potencia.", "speaker": "Daichi", "size": "small", "posX": 40, "posY": 55, "tailX": 25, "tailY": 60, "tailWidth": 6, "tailCurvature": -22, "width": 150, "fontSize": 8, "borderRadius": 18 },
            { "text": "Sostén de chasis soldándose al 100%.", "speaker": "BYTE", "style": "electronic", "size": "small", "posX": 65, "posY": 55, "tailX": 70, "tailY": 60, "tailWidth": 6, "tailCurvature": -22, "width": 130, "fontSize": 8, "borderRadius": 18 }
          ]
        },
        {
          "focusY": 0.9,
          "dialogue": [
            { "text": "Esta noche no se duerme. Mañana tenemos dos bestias listas para la pista.", "speaker": "Ian", "size": "small", "posX": 60, "posY": 70, "tailX": 55, "tailY": 80, "tailWidth": 6, "tailCurvature": -22, "width": 160, "fontSize": 8, "borderRadius": 18 }
          ]
        }
      ]
    },
    "11": {
      "panels": [
        {
          "focusY": 0.15,
          "dialogue": [
            { "text": "¡Ese es el ritmo! La carrera es dentro de poco y no hay margen de error.", "speaker": "Ren", "size": "small", "posX": 55, "posY": 0, "tailX": 70, "tailY": 10, "tailWidth": 6, "tailCurvature": -22, "width": 150, "fontSize": 8, "borderRadius": 18 }
          ]
        },
        {
          "focusY": 0.4,
          "dialogue": [
            { "text": "Cableado listo. Inyectores calibrados.", "speaker": "Ian", "size": "small", "posX": 40, "posY": 30, "tailX": 15, "tailY": 35, "tailWidth": 6, "tailCurvature": -22, "width": 130, "fontSize": 8, "borderRadius": 18 },
            { "text": "Frenos de competición ajustados al milímetro.", "speaker": "Daichi", "size": "small", "posX": 100, "posY": 25, "tailX": 95, "tailY": 35, "tailWidth": 6, "tailCurvature": -22, "width": 140, "fontSize": 8, "borderRadius": 18 }
          ]
        },
        {
          "focusY": 0.65,
          "dialogue": [
            { "text": "que tenes ahi?", "speaker": "Brooke", "size": "small", "posX": 55, "posY": 45, "tailX": 45, "tailY": 50, "tailWidth": 6, "tailCurvature": -22, "width": 150, "fontSize": 8, "borderRadius": 18 },
            { "text": "es para sincronizar ambos autos, en video llamada", "style": "electronic", "size": "small", "posX": 80, "posY": 50, "tailX": 70, "tailY": 55, "tailWidth": 6, "tailCurvature": -22, "width": 120, "fontSize": 8, "borderRadius": 18, "fontFamily": "marker" }
          ]
        },
        {
          "focusY": 0.8,
          "dialogue": [
            { "text": "Voy a dar la primera vuelta de prueba al Eclipse GT.", "speaker": "Ian", "size": "small", "posX": 70, "posY": 65, "tailX": 50, "tailY": 65, "tailWidth": 6, "tailCurvature": -22, "width": 150, "fontSize": 8, "borderRadius": 18 }
          ]
        },
        {
          "focusY": 0.95,
          "dialogue": [
            { "text": "Miren cómo lucen esas dos máquinas juntas.", "speaker": "Brooke", "size": "small", "posX": 70, "posY": 75, "tailX": 75, "tailY": 80, "tailWidth": 6, "tailCurvature": -22, "width": 150, "fontSize": 8, "borderRadius": 18 }
          ]
        }
      ]
    },
    "12": {
      "panels": [
        {
          "focusY": 0.2,
          "dialogue": [
            { "text": "¡La aceleración de este turbo es brutal!", "speaker": "Ian", "size": "small", "posX": 50, "posY": 30, "tailX": 35, "tailY": 35, "tailWidth": 6, "tailCurvature": -22, "width": 140, "fontSize": 8, "borderRadius": 18 }
          ]
        },
        {
          "focusY": 0.45,
          "dialogue": [
            { "text": "La suspensión responde perfecto en la transferencia de peso.", "speaker": "Ian", "size": "small", "posX": 70, "posY": 35, "tailX": 25, "tailY": 45, "tailWidth": 6, "tailCurvature": -22, "width": 150, "fontSize": 8, "borderRadius": 18 }
          ]
        },
        {
          "focusY": 0.7,
          "dialogue": []
        },
        {
          "focusY": 0.9,
          "dialogue": [
            { "text": "parece que lo hubieses manejado antes ", "speaker": "Brooke", "size": "small", "posX": 35, "posY": 75, "tailX": 55, "tailY": 80, "tailWidth": 6, "tailCurvature": -22, "width": 150, "fontSize": 8, "borderRadius": 18 }
          ]
        }
      ]
    },
